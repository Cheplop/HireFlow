{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/login.js",
    "app/register.jsxs",
    "components/common/PrimaryButton.js",
    "components/common/AuthInput.js",
    "app/(tabs)/index.js"
  ]
}
